# Server-only base URL for the Laravel API. Never exposed to the browser.
API_URL=http://localhost:8000/api/v1

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe test-mode publishable key (pk_test_...). The secret key lives only in Laravel.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# httpOnly cookie names used by the BFF. Tokens are never stored in localStorage.
AUTH_COOKIE_NAME=nocfinity_token
ADMIN_AUTH_COOKIE_NAME=nocfinity_admin_token
CART_COOKIE_NAME=nocfinity_cart

# Set to true only when serving over HTTPS (production).
COOKIE_SECURE=false
